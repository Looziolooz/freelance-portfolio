# Database
DATABASE_URL="file:./dev.db"

# Internal /admin area — HTTP Basic Auth (see src/middleware.ts). If unset, the
# whole /admin area returns 503 (fails closed). Use a long, random password.
ADMIN_USER="lorenzo"
ADMIN_PASS="change-this-to-a-long-random-passphrase"

# Contact/audit/booking forms — Resend sends each lead to hello@looz.design.
# Free hobby tier (~3.000 emails/month, no IP allowlisting, works from serverless).
# Get the key at resend.com → API Keys → Create. Domain looz.design must be verified.
RESEND_API_KEY="re_..."
# Optional: override the From address for form notifications (must be verified in Resend).
# RESEND_FROM_EMAIL="hello@looz.design"
# Where lead notifications LAND. Set this to the real mailbox (e.g. the Gmail
# behind hello@) so delivery skips the ImprovMX forwarding hop; unset, it falls
# back to the From address and takes the fragile long way round.
# LEAD_TO_EMAIL="tua-casella-reale@gmail.com"

# Auth (generate a random 64-char hex string)
JWT_SECRET="change-this-to-a-random-secret"

# Stripe — get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs — create products at https://dashboard.stripe.com/products
STRIPE_SUPPORTER_PRICE_ID="price_supporter_monthly"
STRIPE_PRO_PRICE_ID="price_pro_monthly"

# AI Agents (Next.js runtime) — at least ONE provider key is required for the
# on-site agents at /api/agents/[type]. Auto-detected in this order:
# anthropic -> openai -> groq. Groq has a generous FREE tier (console.groq.com),
# so it's the easiest way to get the agents working without paying.
GROQ_API_KEY="gsk_your_api_key_here"   # free tier — recommended to start
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."
# Optional overrides:
LLM_PROVIDER="groq"                    # "anthropic" | "openai" | "groq"
ANTHROPIC_MODEL="claude-haiku-4-5"
OPENAI_MODEL="gpt-4o-mini"
GROQ_MODEL="llama-3.3-70b-versatile"
