# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# python / backend
__pycache__/
*.pyc
venv/
.venv/

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Sellable content pack (paid guides) — DB-only, never commit
/content/connettori/
/content/claude-da-zero/
/content/claude-code-da-zero/
/content/claude-api-da-zero/
/content/claude-cowork-da-zero/
/content/frontend-effetti/
/content/ponytail/
/content/pmi/
/content/strumenti-ai/
/content/dev-ai/

# Social/marketing scripts — local working material
/content/social/
.gstack/

# Local AI-harness config (impeccable skill + hooks): reinstall with `npx impeccable install`
.claude/

# Third-party reference material downloaded while designing the brand manual —
# a Freepik template and a pitch-deck example. Not ours to redistribute.
/brand-manual-template-design/
/brand-manual-template-design.zip
/Brand guidelines and deck mockups.zip
/Leadership Pitch Deck.html

# Throwaway measurement artefacts
/lh-report.json
/page.png

# Merch photographs that were judged and pulled: a misspelled or broken
# wordmark, another brand's monogram, the wrong palette, a Gemini watermark, or
# a second shot of an object already in the set. The reasons are recorded in
# DESIGN.md; the files themselves are ~2.5MB of material that must never ship,
# and `scripts/merch-manifest.py` already refuses to list them.
public/brand-merch/*/_rejected/
public/brand-merch/*/_rejected-text/
public/brand-merch/*/_offpalette/
public/brand-merch/*/_watermark/
public/brand-merch/*/_duplicate/
